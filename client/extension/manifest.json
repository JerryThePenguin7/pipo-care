{
  "manifest_version": 3,
  "name": "Pipo Care — Eye Comfort",
  "version": "1.1.0",
  "description": "Counts your blinks with the camera, warns you before your eyes dry out, and explains your dry-eye risk. Runs entirely on your machine.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "notifications", "sidePanel"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Pipo Care",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["vision/*", "models/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
